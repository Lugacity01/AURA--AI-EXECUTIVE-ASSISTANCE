datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum MessageSender {
  USER
  ASSISTANT
  SYSTEM
}

enum EmailStatus {
  UNREAD
  READ
  NEEDS_APPROVAL
  APPROVED
  SENT
  IGNORED
  ARCHIVED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}
enum CampaignStatus {
  DRAFT
  GENERATING
  READY
  APPROVAL_PENDING
  APPROVED
  SCHEDULED
  SENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum CampaignRecipientStatus {
  PENDING
  GENERATED
  APPROVED
  SENT
  FAILED
  OPENED
  CLICKED
  REPLIED
}

enum CampaignType {
  MEETING
  NEWSLETTER
  FOLLOW_UP
  REMINDER
  ANNOUNCEMENT
  OUTREACH
  RECRUITMENT
  CUSTOM
}

enum CommunicationChannel {
  EMAIL
  WHATSAPP
}

enum FollowUpType {
  REMINDER
  FOLLOW_UP
  CUSTOM
}

enum ContactActivityType {
  EMAIL_SENT
  EMAIL_RECEIVED
  MEETING
  CAMPAIGN
  REPLY
  NOTE
  AI_INTERACTION
}

model User {
  id            String          @id @map("_id")
  name          String
  email         String          @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  conversations Conversation[]
  feedbacks     Feedback[]
  
  // Extensions
  emails        Email[]
  contacts      ContactMemory[]
  integrations  Integration[]

  @@map("user")
}

model Session {
  id        String   @id @map("_id")
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @map("_id")
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id @map("_id")
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model Conversation {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  visitorId   String?   // Anonymous sessions
  userId      String?   // Removed @db.ObjectId
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  messages    Message[]

  @@index([visitorId])
  @@index([userId])
  @@map("conversation")
}

model Message {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String        @db.ObjectId
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         MessageSender
  text           String
  sources        String[]      // citation list
  confidence     String?
  latency        String?
  createdAt      DateTime      @default(now())
  feedbacks      Feedback[]

  @@map("message")
}

model KnowledgeDocument {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String
  version     String
  checksum    String   // MD5 checksum of the parsed file
  isActive    Boolean  @default(false)
  filename    String
  mimeType    String
  fileSize    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  chunks      DocumentChunk[]

  @@map("knowledge_document")
}

model DocumentChunk {
  id                 String            @id @default(auto()) @map("_id") @db.ObjectId
  documentId         String            @db.ObjectId
  document           KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  articleId          String
  chunkId            String
  title              String
  section            String
  slug               String
  category           String
  confidence         String
  searchBoost        Int
  audience           String[]
  tags               String[]
  aliases            String[]
  canonicalQuestions String[]
  related            String[]
  content            String
  embedding          Float[]           // Vector embeddings
  createdAt          DateTime          @default(now())

  @@index([articleId])
  @@index([chunkId])
  @@map("document_chunk")
}

model Feedback {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  messageId  String   @db.ObjectId
  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId     String?  // Removed @db.ObjectId
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  isPositive Boolean
  comment    String?
  createdAt  DateTime @default(now())

  @@map("feedback")
}

model Email {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  threadId       String       // Gmail Thread ID
  gmailId        String       @unique // Gmail Message ID
  historyId      String?
  labelIds       String[]
  snippet        String?
  internalDate   DateTime?
  hasAttachments Boolean      @default(false)
  from           String
  fromName       String?
  to             String
  subject        String
  body           String       // Legacy/general body field
  bodyText       String?      // Plain Text body (for AI pipeline)
  bodyHtml       String?      // HTML body (for UI rendering)
  summary        String?      // AI-generated summary
  status         EmailStatus  @default(UNREAD)
  receivedAt     DateTime
  processedAt    DateTime     @default(now())
  
  // Relations
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  draft          EmailDraft?
  
  @@index([userId])
  @@index([status])
  @@map("email")
}

model EmailDraft {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  emailId        String       @db.ObjectId @unique
  email          Email        @relation(fields: [emailId], references: [id], onDelete: Cascade)
  draftContent   String
  riskLevel      RiskLevel    @default(LOW)
  riskAnalysis   String?      // AI-generated description of risk assessment
  confidence     Float        // AI confidence score
  isApproved     Boolean      @default(false)
  approvedAt     DateTime?
  approvedBy     String?      // Reference to the user if approved

  // Specification compatibility fields
  userId         String?
  recipient      String?
  subject        String?
  body           String?
  status         String?      // Draft, Ready, Approved, Sent, Archived
  threadId       String?
  createdAt      DateTime     @default(now())
  
  @@map("email_draft")
}

model ContactMemory {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  email          String       @unique
  name           String?
  company        String?
  relationship   String?      // e.g. Partner, Client, Team Member
  preferences    String?      // e.g. "Prefers concise updates"
  memorySummary  String?      // Context about past interactions
  lastInteractionAt DateTime  @default(now())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("contact_memory")
}

model Integration {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  provider       String       // e.g. "GMAIL", "CALENDAR", "SLACK", "NOTION"
  isActive       Boolean      @default(true)
  accessToken    String?
  refreshToken   String?
  expiresAt      DateTime?
  settings       String?      // JSON string of custom settings (e.g. auto-reply rules)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("integration")
}

model EmailConnection {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  userId             String
  provider           String    // e.g. "GMAIL"
  providerUserId     String?
  emailAddress       String
  displayName        String?
  avatarUrl          String?
  accessToken        String?
  refreshToken       String?
  expiresAt          DateTime?
  scope              String?
  isActive           Boolean   @default(true)
  isSyncing          Boolean   @default(false)
  syncStartedAt      DateTime?
  lastSuccessfulSync DateTime?
  connectedAt        DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt
  lastSyncedAt       DateTime?
  lastHistoryId      String?

  @@index([userId])
  @@map("email_connection")
}

model Contact {
  id                  String       @id @default(auto()) @map("_id") @db.ObjectId
  userId              String
  name                String
  email               String
  company             String?
  phone               String?
  notes               String?
  lastInteraction     DateTime     @default(now())
  
  // New V7 fields
  jobTitle            String?
  department          String?
  organizationId      String?      @db.ObjectId
  organization        Organization? @relation(fields: [organizationId], references: [id])
  avatar              String?
  website             String?
  linkedin            String?
  preferredTone       String?
  relationshipType    String?
  aiSummary           String?

  // Relations
  groupMemberships    ContactGroupMember[]
  campaignRecipients  CampaignRecipient[]
  tags                ContactTag[]
  activities          ContactActivity[]

  @@index([userId])
  @@unique([userId, email])
  @@map("contact")
}

model Organization {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  website     String?
  industry    String?
  description String?
  logo        String?
  userId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  contacts    Contact[]

  @@index([userId])
  @@map("organization")
}

model ContactActivity {
  id          String              @id @default(auto()) @map("_id") @db.ObjectId
  contactId   String              @db.ObjectId
  contact     Contact             @relation(fields: [contactId], references: [id], onDelete: Cascade)
  type        ContactActivityType
  title       String
  description String?
  timestamp   DateTime            @default(now())
  metadata    String?             // JSON string for deep linking e.g. {"campaignId":"...", "emailId":"..."}

  @@index([contactId])
  @@map("contact_activity")
}

model Tag {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  userId      String
  name        String
  color       String?
  createdAt   DateTime     @default(now())
  
  contactTags ContactTag[]

  @@index([userId])
  @@map("tag")
}

model ContactTag {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  contactId String   @db.ObjectId
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tagId     String   @db.ObjectId
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([contactId, tagId])
  @@map("contact_tag")
}

model ContactGroup {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  userId      String
  name        String
  description String?
  color       String?
  icon        String?
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  members     ContactGroupMember[]

  @@index([userId])
  @@map("contact_group")
}

model ContactGroupMember {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  groupId   String       @db.ObjectId
  group     ContactGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  contactId String       @db.ObjectId
  contact   Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([groupId, contactId])
  @@map("contact_group_member")
}

model Audience {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String
  name        String
  description String?
  rules       String   // JSON string storing dynamic nested rules
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaigns   Campaign[]

  @@index([userId])
  @@map("audience")
}

model Template {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String
  name            String
  description     String?
  basePrompt      String?
  subjectTemplate String?
  bodyTemplate    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  campaigns       Campaign[]

  @@index([userId])
  @@map("template")
}

model Campaign {
  id                 String         @id @default(auto()) @map("_id") @db.ObjectId
  title              String
  description        String?
  campaignType       CampaignType
  audienceId         String?        @db.ObjectId
  audience           Audience?      @relation(fields: [audienceId], references: [id])
  templateId         String?        @db.ObjectId
  template           Template?      @relation(fields: [templateId], references: [id])
  parentCampaignId   String?        @db.ObjectId
  parentCampaign     Campaign?      @relation("CampaignFollowUps", fields: [parentCampaignId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  followUps          Campaign[]     @relation("CampaignFollowUps")
  followUpType       FollowUpType?
  channel            CommunicationChannel @default(EMAIL)
  userId             String
  status             CampaignStatus @default(DRAFT)
  scheduledAt        DateTime?
  eventDate          DateTime?
  eventDuration      Int?
  meetLink           String?
  includeMeetLink    Boolean        @default(true)
  
  
  // Analytics Fields
  totalRecipients    Int            @default(0)
  pendingRecipients  Int            @default(0)
  approvedRecipients Int            @default(0)
  emailsGenerated    Int            @default(0)
  emailsSent         Int            @default(0)
  failedRecipients   Int            @default(0)
  opened             Int            @default(0)
  clicked            Int            @default(0)
  replied            Int            @default(0)

  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  recipients         CampaignRecipient[]
  attachments        CampaignAttachment[]
  jobs               CampaignQueue[]

  @@index([userId])
  @@map("campaign")
}

model CampaignAttachment {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  campaignId       String   @db.ObjectId
  campaign         Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  storageKey       String
  originalFilename String
  mimeType         String?
  size             Int?
  fileData         String?  // Base64 encoded file content
  uploadedBy       String?
  uploadedAt       DateTime @default(now())

  @@index([campaignId])
  @@map("campaign_attachment")
}

model CampaignRecipient {
  id                     String                  @id @default(auto()) @map("_id") @db.ObjectId
  campaignId             String                  @db.ObjectId
  campaign               Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId              String                  @db.ObjectId
  contact                Contact                 @relation(fields: [contactId], references: [id], onDelete: Cascade)
  personalizedSubject    String?
  personalizedBody       String?
  personalizationContext String?                 // JSON context used for AI generation
  approvalStatus         CampaignRecipientStatus @default(PENDING)
  sendStatus             CampaignRecipientStatus @default(PENDING)
  failedReason           String?

  // Timestamps
  generatedAt            DateTime?
  approvedAt             DateTime?
  sentAt                 DateTime?
  openedAt               DateTime?
  clickedAt              DateTime?
  repliedAt              DateTime?

  @@index([campaignId])
  @@index([contactId])
  @@map("campaign_recipient")
}

model CampaignQueue {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  campaignId  String   @db.ObjectId
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  status      String   @default("QUEUED") // QUEUED, PROCESSING, COMPLETED, FAILED
  attempts    Int      @default(0)
  nextRunAt   DateTime @default(now())
  lastError   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([campaignId])
  @@index([status, nextRunAt])
  @@map("campaign_queue")
}

model AutomationRule {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  userId       String
  title        String
  desc         String
  enabled      Boolean   @default(false)
  lastExecuted String?
  successRate  String?

  @@index([userId])
  @@map("automation_rule")
}

model AgentAction {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  userId       String
  action       String    // e.g. "Read Email", "Draft Created", "Email Sent", "Approval Requested"
  desc         String
  timestamp    DateTime  @default(now())
  reason       String?
  toolUsed     String?
  duration     String?
  outcome      String?
  status       String?

  @@index([userId])
  @@map("agent_action")
}
